DART_API_KEY=your_opendart_api_key
NAVER_API_HUB_CLIENT_ID=your_naver_api_hub_client_id
NAVER_API_HUB_CLIENT_SECRET=your_naver_api_hub_client_secret
NEWS_LOOKBACK_DAYS=2
OPENAI_API_KEY=your_openai_api_key_optional
OPENAI_MODEL=gpt-5.4-mini
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your_sender@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_USE_TLS=true
MAIL_FROM=your_sender@example.com
MAIL_TO=recipient1@example.com,recipient2@example.com
EMAIL_REQUIRED=false
