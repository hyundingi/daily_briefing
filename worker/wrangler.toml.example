name = "competitor-newsletter"
main = "src/index.js"
compatibility_date = "2026-09-03"

[placement]
region = "gcp:asia-northeast3"

[triggers]
crons = ["*/30 * * * *", "30 22 * * *"]

[vars]
GOV_PROJECT_KEYWORDS = "바이오,헬스,제약,의료,디지털헬스,R&D"
BIZINFO_API_URL = "https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do"
NTIS_API_URL = "https://www.ntis.go.kr/rndopen/openApi/public_project?apprvKey={key}&collection=project&SRWR={keyword}&searchFd=BI&startPosition={page}&displayCnt={limit}"

[[kv_namespaces]]
binding = "BRIEFING_KV"
id = "YOUR_KV_NAMESPACE_ID"

[[d1_databases]]
binding = "DB"
database_name = "competitor-newsletter-db"
database_id = "YOUR_D1_DATABASE_ID"

# Secrets to set with `wrangler secret put NAME`:
# DART_API_KEY
# NAVER_API_HUB_CLIENT_ID
# NAVER_API_HUB_CLIENT_SECRET
# GEMINI_API_KEY
# GEMINI_MODEL                 optional, default: gemini-3.6-flash
# UPDATE_PASSWORD              optional but recommended

